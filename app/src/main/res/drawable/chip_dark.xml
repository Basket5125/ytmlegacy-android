<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape><solid android:color="@color/holo_blue_dark" /><corners android:radius="16dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/pressed_blue" /><stroke android:width="1dp" android:color="@color/holo_blue" /><corners android:radius="16dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/dark_card" /><stroke android:width="1dp" android:color="#FF5A646D" /><corners android:radius="16dp" /></shape>
    </item>
</selector>
