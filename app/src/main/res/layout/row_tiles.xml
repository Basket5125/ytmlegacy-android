    <TextView android:id="@+id/tile_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical" android:paddingLeft="14dp" android:singleLine="true" android:textColor="?attr/ytmText" android:textSize="14sp" android:textStyle="bold" />
