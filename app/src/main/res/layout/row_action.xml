<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="?attr/ytmItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingRight="10dp">

    <ImageView
        android:id="@+id/action_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/ytmCard"
        android:contentDescription="@null"
        android:scaleType="center" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="14dp">

        <TextView android:id="@+id/action_title" style="@style/RowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/action_subtitle" style="@style/RowSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
