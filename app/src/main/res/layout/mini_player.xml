<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mini"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/ytmSurface"
    android:orientation="vertical"
    android:visibility="gone">

    <ProgressBar
        android:id="@+id/mini_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="1000"
        android:progressDrawable="@drawable/mini_progress" />

    <LinearLayout
        android:id="@+id/mini_body"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mini_height"
        android:background="?attr/ytmItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mini_art"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="10dp"
            android:paddingRight="6dp">

            <TextView android:id="@+id/mini_title" style="@style/RowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/mini_artist" style="@style/RowSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageButton
                android:id="@+id/mini_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/round_button_bg"
                android:contentDescription="@string/action_play"
                android:src="@drawable/ic_play" />

            <!-- Takes the place of the play/pause button while a song loads. -->
            <ProgressBar
                android:id="@+id/mini_loading"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/mini_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginRight="4dp"
            android:background="@drawable/round_button_bg"
            android:contentDescription="@string/action_next"
            android:src="@drawable/ic_skip_next" />
    </LinearLayout>
</LinearLayout>
